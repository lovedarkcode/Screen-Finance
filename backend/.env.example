# Copy to backend/.env and set your own credentials. Never commit backend/.env.
ENVIRONMENT=development
DEBUG=true
PORT=8000
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/screenfinance
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
GOOGLE_CLIENT_ID=
OPENAI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Optional separate model for feed query parsing; empty reuses NVIDIA_MODEL.
NVIDIA_SCREENER_MODEL=
# When set, Nebius is used for screening and stock analysis.
NEBIUS_API_KEY=
# Website alias; the backend resolves this to the Token Factory inference endpoint.
NEBIUS_BASE_URL=https://nebius.ai
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# Existing local FMP=... values are also accepted; prefer this canonical name.
FMP_API_KEY=
# Quarterly results now use Yahoo; no financial-data API key is required.
# These tickers get priority; they do not restrict the full exchange universe.
RESULTS_TICKERS=RELIANCE.NS,TATASTEEL.NS,AAPL,MSFT
RESULTS_AI_BATCH_SIZE=8
RESULTS_BATCH_SIZE=150
RESULTS_REQUEST_DELAY=1
RESULTS_REFRESH_HOURS=24
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
POLYGON_API_KEY=
